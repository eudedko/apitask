apiVersion: v1
kind: Namespace
metadata:
  name: github-api-proxy-production
---
apiVersion: v1
data:
  CACHE_TTL_SECONDS: "300"
  NODE_ENV: production
kind: ConfigMap
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: github-api-proxy
  name: app-config-k6c4h96fk2
  namespace: github-api-proxy-production
---
apiVersion: v1
kind: Secret
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: github-api-proxy
  name: database-credentials
  namespace: github-api-proxy-production
stringData:
  password: replace-with-production-password
  username: production_proxy
type: Opaque
---
apiVersion: v1
kind: Secret
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: github-api-proxy
  name: github-api-credentials
  namespace: github-api-proxy-production
stringData:
  token: replace-with-production-github-token
type: Opaque
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: github-api-proxy
  name: github-api-proxy
  namespace: github-api-proxy-production
spec:
  ports:
  - name: http
    port: 3200
    protocol: TCP
    targetPort: http
  selector:
    app.kubernetes.io/component: proxy
  type: ClusterIP
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: github-api-proxy
  name: mongodb
  namespace: github-api-proxy-production
spec:
  ports:
  - name: mongodb
    port: 27017
    protocol: TCP
    targetPort: mongodb
  selector:
    app.kubernetes.io/component: database
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: github-api-proxy
  name: mongodb-data
  namespace: github-api-proxy-production
spec:
  accessModes:
  - ReadWriteOnce
  resources:
    requests:
      storage: 200Mi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: github-api-proxy
  name: github-api-proxy
  namespace: github-api-proxy-production
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/component: proxy
  template:
    metadata:
      labels:
        app.kubernetes.io/component: proxy
    spec:
      containers:
      - env:
        - name: PORT
          value: "3200"
        - name: MONGO_DATABASE
          value: github_proxy
        - name: DB_USERNAME
          valueFrom:
            secretKeyRef:
              key: username
              name: database-credentials
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: database-credentials
        - name: MONGO_HOST
          value: mongodb
        - name: MONGO_PORT
          value: "27017"
        - name: GITHUB_TOKEN
          valueFrom:
            secretKeyRef:
              key: token
              name: github-api-credentials
        envFrom:
        - configMapRef:
            name: app-config-k6c4h96fk2
        image: github-api-proxy:1.0.0
        imagePullPolicy: IfNotPresent
        livenessProbe:
          httpGet:
            path: /
            port: http
          initialDelaySeconds: 15
          periodSeconds: 20
        name: proxy
        ports:
        - containerPort: 3200
          name: http
          protocol: TCP
        readinessProbe:
          httpGet:
            path: /
            port: http
          initialDelaySeconds: 5
          periodSeconds: 10
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 128Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: github-api-proxy
  name: mongodb
  namespace: github-api-proxy-production
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/component: database
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app.kubernetes.io/component: database
    spec:
      containers:
      - env:
        - name: MONGO_INITDB_ROOT_USERNAME
          valueFrom:
            secretKeyRef:
              key: username
              name: database-credentials
        - name: MONGO_INITDB_ROOT_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: database-credentials
        image: mongo:8.3
        livenessProbe:
          initialDelaySeconds: 30
          periodSeconds: 20
          tcpSocket:
            port: mongodb
        name: mongodb
        ports:
        - containerPort: 27017
          name: mongodb
          protocol: TCP
        readinessProbe:
          exec:
            command:
            - sh
            - -c
            - 'mongosh --quiet --host 127.0.0.1 --username "$MONGO_INITDB_ROOT_USERNAME"
              --password "$MONGO_INITDB_ROOT_PASSWORD" --authenticationDatabase admin
              --eval ''quit(db.adminCommand("ping").ok ? 0 : 2)'''
          initialDelaySeconds: 10
          periodSeconds: 10
        resources:
          limits:
            cpu: 500m
            memory: 1Gi
          requests:
            cpu: 100m
            memory: 256Mi
        volumeMounts:
        - mountPath: /data/db
          name: data
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: mongodb-data
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: github-api-proxy
  name: github-api-proxy
  namespace: github-api-proxy-production
spec:
  ingressClassName: nginx
  rules:
  - host: api-proxy.example.com
    http:
      paths:
      - backend:
          service:
            name: github-api-proxy
            port:
              name: http
        path: /
        pathType: Prefix
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: github-api-proxy
  name: mongodb
  namespace: github-api-proxy-production
spec:
  ingress:
  - from:
    - podSelector:
        matchLabels:
          app.kubernetes.io/component: proxy
    ports:
    - port: 27017
      protocol: TCP
  podSelector:
    matchLabels:
      app.kubernetes.io/component: database
  policyTypes:
  - Ingress
